# Copy to .env and replace placeholders. Never commit the real .env.
# Generate strong random values; do not reuse passwords.
APP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Persistence and HTTP behavior
DATABASE_PATH=/data/watchtower.db
PORT=8080
DEFAULT_INTERVAL=300
REQUEST_TIMEOUT=20
MAX_RESPONSE_BYTES=2097152
USER_AGENT=VPS-Watchtower/1.0
LOG_LEVEL=INFO

# Required by production Caddy only; use a real DNS name you control.
DOMAIN=example.com

# Telegram (leave empty unless configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (leave empty unless configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true

# Discord and generic webhook (leave empty unless configured)
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
